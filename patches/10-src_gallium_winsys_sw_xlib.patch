+#ifdef HAVE_X11_DRM
+/**
+ * Bind the driver's buffer to a pixmap on the server, and give that pixmap a
+ * fence the server triggers when it is done reading it.
+ *
+ * This happens on the first present rather than when the display target is
+ * created, because DRI3 wants the window the pixmap belongs to and only the
+ * present knows it.  The buffer fd is spent here: on this platform it carries
+ * a graphics-allocator handle that the server consumes, so it is good for
+ * exactly one pixmap.  A display target is therefore bound to the first
+ * drawable it is presented against, which is all the xlib GLX frontend needs --
+ * it builds one framebuffer per drawable, and drops its textures (and with
+ * them this display target) whenever the drawable is resized.
+ */
+static bool
+xlib_dri3_bind(struct xlib_displaytarget *xlib_dt,
+               struct xlib_drawable *xlib_drawable)
+{
+   xcb_connection_t *c = XGetXCBConnection(xlib_dt->display);
+   xcb_generic_error_t *error;
+
+   if (xlib_dt->buffer_fd < 0) {
+      mesa_loge("xlib: display target has no buffer left to bind");
+      return false;
+   }
+
+   /* Only a window can be given a buffer this way, and asking is the only way
+    * to find out: a GLX drawable may well be a pixmap, which is what Wine
+    * renders into when it has no XComposite to redirect a window with.
+    *
+    * Finding out by trying is not an option.  PixmapFromBuffer carries the
+    * buffer's file descriptor, and a server that rejects the request before
+    * reading it leaves that descriptor queued on the connection, where it is
+    * mistaken for the next one and takes the connection down.  This request
+    * carries nothing, so failing it costs only the round-trip.
+    */
+   xcb_get_window_attributes_reply_t *attr =
+      xcb_get_window_attributes_reply(c,
+                                      xcb_get_window_attributes(c, xlib_drawable->drawable),
+                                      &error);
+   if (!attr) {
+      free(error);
+      return false;
+   }
+   free(attr);
+
+   xlib_dt->pixmap = xcb_generate_id(c);
+   xcb_void_cookie_t pixmap_cookie =
+      xcb_dri3_pixmap_from_buffer_checked(c, xlib_dt->pixmap,
+                                          xlib_drawable->drawable,
+                                          xlib_dt->stride * xlib_dt->height,
+                                          xlib_dt->width, xlib_dt->height,
+                                          xlib_dt->stride,
+                                          xlib_drawable->depth,
+                                          util_format_get_blocksizebits(xlib_dt->format),
+                                          xlib_dt->buffer_fd);
+
+   /* xcb_dri3_pixmap_from_buffer() takes ownership of the fd whether or not
+    * the request succeeds.
+    */
+   xlib_dt->buffer_fd = -1;
+
+   error = xcb_request_check(c, pixmap_cookie);
+   if (error) {
+      mesa_loge("xlib: DRI3 PixmapFromBuffer failed (X error %d)",
+                error->error_code);
+      free(error);
+      xlib_dt->pixmap = 0;
+      return false;
+   }
+
+   /* Created already triggered: nothing is reading the buffer yet, and the
+    * first present resets it, which the protocol only allows on a fence that
+    * is currently triggered.
+    */
+   xlib_dt->idle_fence = xcb_generate_id(c);
+   xcb_void_cookie_t fence_cookie =
+      xcb_sync_create_fence_checked(c, xlib_dt->pixmap, xlib_dt->idle_fence,
+                                    true);
+
+   error = xcb_request_check(c, fence_cookie);
+   if (error) {
+      mesa_loge("xlib: SYNC CreateFence failed (X error %d)",
+                error->error_code);
+      free(error);
+      xcb_free_pixmap(c, xlib_dt->pixmap);
+      xlib_dt->pixmap = 0;
+      xlib_dt->idle_fence = 0;
+      return false;
+   }
+
+   xlib_dt->drawable = xlib_drawable->drawable;
+
+   return true;
+}
+
+
+/**
+ * Give up presenting this display target directly and go back to putting the
+ * pixels on the drawable ourselves, for the rest of its life.
+ *
+ * Reached when the drawable turns out not to be one the server will take a
+ * buffer for, and when it is replaced by another: the buffer is spent by the
+ * binding, so there is nothing left to bind to a second drawable.  Wine does
+ * both, swapping a window for a pixmap mid-run when a second window appears
+ * and it has no XComposite to redirect with.
+ *
+ * The storage allocated here is what the driver looks for -- a display target
+ * it can map is one it has to fill -- so the change takes effect on the next
+ * frame.  This one is lost, having been rendered somewhere nobody will read.
+ */
+static void
+xlib_dri3_give_up(struct xlib_displaytarget *xlib_dt)
+{
+   unsigned size =
+      xlib_dt->stride * util_format_get_nblocksy(xlib_dt->format,
+                                                 xlib_dt->height);
+   int ignore;
+
+   xlib_dri3_destroy(xlib_dt);
+   xlib_dt->direct = false;
+
+   if (!debug_get_option_xlib_no_shm() &&
+       XQueryExtension(xlib_dt->display, "MIT-SHM", &ignore, &ignore, &ignore)) {
+      xlib_dt->data = alloc_shm(xlib_dt, size);
+      if (xlib_dt->data)
+         xlib_dt->shm = True;
+   }
+
+   if (!xlib_dt->data)
+      xlib_dt->data = align_malloc(size, 64);
+
+   if (!xlib_dt->data)
+      mesa_loge("xlib: no storage to fall back to; nothing will be presented");
+}
+
+
+/**
+ * Hand the buffer to the server without copying it anywhere.
+ *
+ * The damage region is left empty (present the whole pixmap): describing a
+ * partial update needs XFIXES, which is not something a bare xlib GLX target
+ * can count on, and a SwapBuffers is a full-surface update anyway.
+ */
+static void
+xlib_dri3_display(struct xlib_displaytarget *xlib_dt,
+                  struct xlib_drawable *xlib_drawable)
+{
+   xcb_connection_t *c = XGetXCBConnection(xlib_dt->display);
+
+   if (!xlib_dt->pixmap) {
+      if (!xlib_dri3_bind(xlib_dt, xlib_drawable)) {
+         xlib_dri3_give_up(xlib_dt);
+         return;
+      }
+   } else if (xlib_dt->drawable != xlib_drawable->drawable) {
+      xlib_dri3_give_up(xlib_dt);
+      return;
+   }
+
+   /* Wait for the previous present to be done with the buffer before handing
+    * it over again.  This gates the server's request stream, not ours, so it
+    * costs no round-trip.
+    */
+   xcb_sync_await_fence(c, 1, &xlib_dt->idle_fence);
+   xcb_sync_reset_fence(c, xlib_dt->idle_fence);
+
+   xcb_present_pixmap(c, xlib_drawable->drawable, xlib_dt->pixmap,
+                      xlib_dt->serial++,
+                      0,                    /* valid region: whole pixmap */
+                      0,                    /* update region: whole pixmap */
+                      0, 0,                 /* x_off, y_off */
+                      0,                    /* target_crtc */
+                      0,                    /* wait_fence */
+                      xlib_dt->idle_fence,
+                      0,                    /* options */
+                      0, 0, 0,              /* target_msc, divisor, remainder */
+                      0, NULL);             /* notifies */
+
+   xcb_flush(c);
+}
+
+
+static void
+xlib_dri3_destroy(struct xlib_displaytarget *xlib_dt)
+{
+   xcb_connection_t *c = XGetXCBConnection(xlib_dt->display);
+
+   if (xlib_dt->idle_fence) {
+      xcb_sync_destroy_fence(c, xlib_dt->idle_fence);
+      xlib_dt->idle_fence = 0;
+   }
+
+   if (xlib_dt->pixmap) {
+      xcb_free_pixmap(c, xlib_dt->pixmap);
+      xlib_dt->pixmap = 0;
+   }
+
+   if (xlib_dt->buffer_fd >= 0) {
+      close(xlib_dt->buffer_fd);
+      xlib_dt->buffer_fd = -1;
+   }
+
+   xcb_flush(c);
+}
+#endif /* HAVE_X11_DRM */
