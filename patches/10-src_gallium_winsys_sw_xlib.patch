+/**
+ * Wrap a buffer the driver allocated so that the server can read it directly.
+ *
+ * The handle's fd is the buffer as this platform hands buffers over, ready for
+ * DRI3 PixmapFromBuffer; we take ownership of it.  Nothing here is mappable:
+ * the point of this path is that the pixels never travel through us.
+ */
 static struct sw_displaytarget *
 xlib_displaytarget_from_handle(struct sw_winsys *winsys,
                                const struct pipe_resource *templet,
                                struct winsys_handle *whandle,
                                unsigned *stride)
 {
-   assert(0);
+#ifdef HAVE_X11_DRM
+   struct xlib_displaytarget *xlib_dt;
+
+   if (whandle->type != WINSYS_HANDLE_TYPE_FD)
+      return NULL;
+
+   xlib_dt = CALLOC_STRUCT(xlib_displaytarget);
+   if (!xlib_dt)
+      return NULL;
+
+   xlib_dt->display = ((struct xlib_sw_winsys *)winsys)->display;
+   xlib_dt->format = templet->format;
+   xlib_dt->width = templet->width0;
+   xlib_dt->height = templet->height0;
+   xlib_dt->stride = whandle->stride;
+   xlib_dt->buffer_fd = whandle->handle;
+   xlib_dt->direct = true;
+
+   *stride = xlib_dt->stride;
+   return (struct sw_displaytarget *)xlib_dt;
+#else
    return NULL;
+#endif
 }
 
 
