diff --git a/src/freedreno/ir3/ir3_disk_cache.c b/src/freedreno/ir3/ir3_disk_cache.c
index 3b732d39584..21de010b44a 100644
--- a/src/freedreno/ir3/ir3_disk_cache.c
+++ b/src/freedreno/ir3/ir3_disk_cache.c
@@ -34,18 +34,25 @@ ir3_disk_cache_init(struct ir3_compiler *compiler)
       return;
 
    const char *renderer = fd_dev_name(compiler->dev_id);
-   const struct build_id_note *note =
-      build_id_find_nhdr_for_addr(ir3_disk_cache_init);
-   unsigned build_id_len = build_id_length(note);
-   assert(note && build_id_len == BUILD_ID_EXPECTED_HASH_LENGTH); /* sha1 */
-
-   const uint8_t *id_sha1 = build_id_data(note);
-   assert(id_sha1);
 
    blake3_hasher ctx;
    uint8_t blake3[BLAKE3_KEY_LEN];
    _mesa_blake3_init(&ctx);
-   _mesa_blake3_update(&ctx, id_sha1, build_id_len);
+
+   /* Hash in the ir3 build: the build-id note when the linker emitted one,
+    * otherwise the shared object's timestamp.  Reaching for the note directly
+    * is not safe -- build_id_find_nhdr_for_addr() returns NULL whenever dladdr()
+    * fails or no PT_NOTE holds an NT_GNU_BUILD_ID, and build_id_length() then
+    * reads note->nhdr.n_descsz, faulting on address 0x4.  The assert that was
+    * meant to catch it came after the dereference and b_ndebug compiles it out.
+    * bionic links without --build-id, so Android hits this every time.
+    *
+    * Without a way to tell builds apart we cannot key a cache, so run without
+    * one rather than risk serving stale shaders.
+    */
+   if (!disk_cache_get_function_identifier(ir3_disk_cache_init, &ctx))
+      return;
+
    _mesa_blake3_update(&ctx, &compiler->options.uche_trap_base,
                      sizeof(compiler->options.uche_trap_base));
    _mesa_blake3_final(&ctx, blake3);
