diff --git a/src/gallium/frontends/glx/xlib/xm_api.c b/src/gallium/frontends/glx/xlib/xm_api.c
index c2e7ef01483..ef7155327b3 100644
--- a/src/gallium/frontends/glx/xlib/xm_api.c
+++ b/src/gallium/frontends/glx/xlib/xm_api.c
@@ -1343,16 +1343,14 @@ void XMesaSwapBuffers( XMesaBuffer b )
    }
 
    if (xmctx && xmctx->xm_buffer == b) {
-      struct pipe_fence_handle *fence = NULL;
-      st_context_flush(xmctx->st, ST_FLUSH_FRONT, &fence, NULL, NULL);
-      /* Wait until all rendering is complete */
-      if (fence) {
-         XMesaDisplay xmdpy = xmesa_init_display(b->xm_visual->display);
-         struct pipe_screen *screen = xmdpy->screen;
-         xmdpy->screen->fence_finish(screen, NULL, fence,
-                                     OS_TIMEOUT_INFINITE);
-         xmdpy->screen->fence_reference(screen, &fence, NULL);
-      }
+      /* Submit the frame, but do not block on it finishing: that would idle
+       * the GPU across every swap, since nothing is drawn between the wait and
+       * the next frame's commands.  Whatever presents the buffer is
+       * responsible for its own synchronisation -- a readback through
+       * pipe_texture_map() gets it from the transfer, and a driver that hands
+       * the buffer over instead does it in flush_frontbuffer().
+       */
+      st_context_flush(xmctx->st, ST_FLUSH_FRONT, NULL, NULL, NULL);
    }
 
    xmesa_swap_st_framebuffer(b->drawable);
diff --git a/src/gallium/frontends/glx/xlib/xm_st.c b/src/gallium/frontends/glx/xlib/xm_st.c
index 506289c5a00..745ca827f67 100644
--- a/src/gallium/frontends/glx/xlib/xm_st.c
+++ b/src/gallium/frontends/glx/xlib/xm_st.c
@@ -47,6 +47,22 @@ struct xmesa_st_framebuffer {
    unsigned texture_width, texture_height, texture_mask;
    struct pipe_resource *textures[ST_ATTACHMENT_COUNT];
 
+   /* Back buffers to rotate the back-left attachment through.
+    *
+    * One is enough to draw with but not to pipeline.  Presenting hands the
+    * buffer to someone else -- the X server, in the case that matters here --
+    * and it cannot be drawn into again until they are done with it, so with a
+    * single buffer that wait falls between every frame and the next and the
+    * GPU sits idle across it.  With two, frame N is still being presented
+    * while frame N+1 is being built into the other one.
+    *
+    * Only used when there is no front-left attachment; when there is one, the
+    * front/back swap below already alternates between two buffers.
+    */
+#define XMESA_NUM_BACK 2
+   struct pipe_resource *back_buffers[XMESA_NUM_BACK];
+   unsigned current_back;
+
    struct pipe_resource *display_resource;
 };
 
@@ -134,6 +150,10 @@ xmesa_st_framebuffer_validate_textures(struct pipe_frontend_drawable *drawable,
    if (xstfb->texture_width != width || xstfb->texture_height != height) {
       for (i = 0; i < ST_ATTACHMENT_COUNT; i++)
          pipe_resource_reference(&xstfb->textures[i], NULL);
+
+      for (unsigned b = 0; b < XMESA_NUM_BACK; b++)
+         pipe_resource_reference(&xstfb->back_buffers[b], NULL);
+      xstfb->current_back = 0;
    }
 
    memset(&templ, 0, sizeof(templ));
@@ -184,6 +204,18 @@ xmesa_st_framebuffer_validate_textures(struct pipe_frontend_drawable *drawable,
             xstfb->screen->resource_create(xstfb->screen, &templ);
          if (!xstfb->textures[i])
             return false;
+
+         /* Build the rotation ring around the attachment just allocated.  A
+          * buffer we cannot get is not fatal -- rotation simply stops at the
+          * ones that exist, down to the single-buffer behaviour.
+          */
+         if (i == ST_ATTACHMENT_BACK_LEFT) {
+            pipe_resource_reference(&xstfb->back_buffers[0], xstfb->textures[i]);
+            for (unsigned b = 1; b < XMESA_NUM_BACK; b++)
+               xstfb->back_buffers[b] =
+                  xstfb->screen->resource_create(xstfb->screen, &templ);
+            xstfb->current_back = 0;
+         }
       }
    }
 
@@ -337,6 +369,9 @@ xmesa_destroy_st_framebuffer(struct pipe_frontend_drawable *drawable)
    for (i = 0; i < ST_ATTACHMENT_COUNT; i++)
       pipe_resource_reference(&xstfb->textures[i], NULL);
 
+   for (i = 0; i < XMESA_NUM_BACK; i++)
+      pipe_resource_reference(&xstfb->back_buffers[i], NULL);
+
    free(xstfb);
 }
 
@@ -376,6 +411,21 @@ xmesa_swap_st_framebuffer(struct pipe_frontend_drawable *drawable)
          if (!xmesa_strict_invalidate())
             xmesa_notify_invalid_buffer(xstfb->buffer);
       }
+      else {
+         /* Nothing to swap with, so rotate: draw the next frame into a
+          * different buffer than the one just handed to the display, and let
+          * the two overlap instead of waiting for the first to be released.
+          */
+         unsigned next = (xstfb->current_back + 1) % XMESA_NUM_BACK;
+
+         if (xstfb->back_buffers[next]) {
+            xstfb->current_back = next;
+            pipe_resource_reference(back, xstfb->back_buffers[next]);
+
+            if (!xmesa_strict_invalidate())
+               xmesa_notify_invalid_buffer(xstfb->buffer);
+         }
+      }
 
       if (xmesa_strict_invalidate())
          xmesa_check_buffer_size(xstfb->buffer);
