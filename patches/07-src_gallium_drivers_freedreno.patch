+/**
+ * Screen for a frontend that presents through a gallium software winsys
+ * rather than through a DRI loader.  kgsl exposes no way to enumerate the
+ * device, so the node turnip uses is the one to open.
+ */
+struct pipe_screen *
+fd_screen_create_sw(struct sw_winsys *winsys,
+                    const struct pipe_screen_config *config)
+{
+   int fd = open("/dev/kgsl-3d0", O_RDWR | O_CLOEXEC);
+
+   if (fd < 0) {
+      mesa_loge("freedreno: cannot open /dev/kgsl-3d0: %s", strerror(errno));
+      return NULL;
+   }
+
+   struct pipe_screen *pscreen = fd_screen_create(fd, config, NULL);
+
+   /* fd_screen_create() dups what it needs */
+   close(fd);
+
+   if (!pscreen)
+      return NULL;
+
+   fd_screen(pscreen)->winsys = winsys;
+   pscreen->flush_frontbuffer = fd_flush_frontbuffer;
+
+   return pscreen;
+}
