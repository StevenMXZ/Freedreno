+      /* Submit the frame, then hand the buffer over without waiting for it.
+       *
+       * Ordering is left to the GPU: the server's read of this buffer and the
+       * rendering that fills it are work on the same device, and the present
+       * request cannot reach the server before the submission below has been
+       * made.  This is the same bet the Vulkan WSI makes on this platform,
+       * which has no cross-process fence to offer either -- the server ignores
+       * the wait_fence field of PresentPixmap.
+       *
+       * Blocking here instead would cost the whole pipeline: nothing is drawn
+       * between such a wait and the next frame, so the GPU would idle for
+       * exactly as long as the CPU takes to build it, every frame.
+       */
+      pctx->flush(pctx, NULL, 0);
+   }
+   else {
+      struct pipe_transfer *transfer = NULL;
+      void *src = pipe_texture_map(pctx, prsc, level, layer, PIPE_MAP_READ,
+                                   0, 0,
+                                   u_minify(prsc->width0, level),
+                                   u_minify(prsc->height0, level),
+                                   &transfer);
+      if (src) {
+         util_copy_rect(dst, prsc->format, rsc->display_stride, 0, 0,
+                        transfer->box.width, transfer->box.height,
+                        src, transfer->stride, 0, 0);
+         pipe_texture_unmap(pctx, transfer);
+      }
+      winsys->displaytarget_unmap(winsys, rsc->display_target);
+   }
+
+   if (aux)
+      fd_screen_aux_context_put(pscreen);
+
+   winsys->displaytarget_display(winsys, rsc->display_target,
+                                 winsys_drawable_handle, nboxes, sub_box);
+}
