+/**
+ * Present through a gallium software winsys.  There is no swapchain and no
+ * loader to hand the bo over to, so read the rendered image back and let the
+ * winsys put the pixels on the drawable, the way the software rasterizers do.
+ *
+ * Unless the displaytarget already wraps this resource's own bo, in which case
+ * the winsys hands that buffer straight to the server and there is nothing to
+ * read back -- only the rendering to finish first, which the readback would
+ * otherwise have waited for on our behalf.
+ */
+static void
+fd_flush_frontbuffer(struct pipe_screen *pscreen,
+                     struct pipe_context *pctx,
+                     struct pipe_resource *prsc,
+                     unsigned level, unsigned layer,
+                     void *winsys_drawable_handle,
+                     unsigned nboxes,
+                     struct pipe_box *sub_box)
+{
+   struct fd_screen *screen = fd_screen(pscreen);
+   struct sw_winsys *winsys = screen->winsys;
+   struct fd_resource *rsc = fd_resource(prsc);
+   bool aux = false;
+
+   if (!winsys || !rsc->display_target)
+      return;
+
+   /* the xlib GLX frontend has nothing current to offer when it presents from
+    * a destroyed or never-bound context; the aux context can read back instead
+    */
+   if (!pctx) {
+      pctx = &fd_screen_aux_context_get(pscreen)->base;
+      aux = true;
+   }
+
+   /* A displaytarget wrapping this resource's own bo has no storage of its own
+    * and cannot be mapped; one with storage has to be filled from here.  Ask
+    * every frame rather than remember the answer: the winsys gives the direct
+    * path up when it meets a drawable the server will not take a buffer for,
+    * and allocates storage at that point.
