+  # only the sync_merge()/sync_file_info() half of <android/sync.h>.  When it
+  # is missing, util/libsync.h falls back to its own poll() implementation.
+  'sync_wait': '#include <android/sync.h>',
 }
 
 foreach f, prefix: functions_to_detect
@@ -2308,6 +2312,9 @@ if with_platform_x11
   if with_glx == 'xlib'
     dep_x11 = dependency('x11', version : dep_xlib_version)
     dep_xext = dependency('xext')
+    # The xlib winsys presents through DRI3 where the platform offers it, and
+    # reaches xcb from the Display it was handed.
+    dep_x11_xcb = dependency('x11-xcb')
   elif with_glx == 'dri'
     dep_x11 = dependency('x11', version : dep_xlib_version)
     dep_xext = dependency('xext')
