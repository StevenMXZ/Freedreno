diff --git a/meson.build b/meson.build
index 9e5e145f98e..20bf8c0334e 100644
--- a/meson.build
+++ b/meson.build
@@ -671,8 +671,8 @@ if with_glx != 'disabled'
   elif with_glx == 'xlib'
     if not with_gallium
       error('xlib based GLX requires at least one gallium driver')
-    elif not with_gallium_swrast
-      error('xlib based GLX requires softpipe or llvmpipe.')
+    elif not (with_gallium_swrast or with_gallium_freedreno)
+      error('xlib based GLX requires softpipe, llvmpipe or freedreno.')
     elif with_dri
       error('xlib conflicts with any dri driver')
     endif
@@ -1625,6 +1625,10 @@ functions_to_detect = {
   'posix_fallocate': '',
   'secure_getenv': '',
   'sysconf': '#include <unistd.h>',
