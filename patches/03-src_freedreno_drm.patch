diff --git a/src/freedreno/drm/kgsl/kgsl_bo.c b/src/freedreno/drm/kgsl/kgsl_bo.c
new file mode 100644
index 00000000000..7136c71a322
--- /dev/null
+++ b/src/freedreno/drm/kgsl/kgsl_bo.c
@@ -0,0 +1,674 @@
+/*
+ * Copyright © 2023 Lucas Fryzek <lfryzek@igalia.com>
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <fcntl.h>
+#include <linux/dma-heap.h>
+
+#include "util/os_file.h"
+#include "util/os_mman.h"
+
+#include "../../vulkan/ion/ion.h"
+#include "../../vulkan/ion/ion_4.19.h"
+
+#include "kgsl_priv.h"
+
+#if DETECT_OS_ANDROID
+#include <android/hardware_buffer.h>
+#include <sys/socket.h>
+
+#include "drm-uapi/drm_fourcc.h"
+
+#include <dlfcn.h>
+
+#include "util/u_call_once.h"
+
+/* AHardwareBuffer_getNativeHandle() lives in libandroid.so and has since API
+ * 26, but it is declared only by <vndk/hardware_buffer.h>, an AOSP header the
+ * NDK does not ship.  turnip reaches it through the VNDK sysroot; here there
+ * is none, so declare the little of it that is needed.
+ */
+typedef struct native_handle {
+   int version;
+   int numFds;
+   int numInts;
+   int data[0];
+} native_handle_t;
+
+/* gralloc has always known this one, but the NDK enum omits it. It is what
+ * Winlator's X server allocates for its own drawables.
+ */
+#define HAL_PIXEL_FORMAT_BGRA_8888 5
+
+/*
+ * Resolved at first use rather than linked against.  A DT_NEEDED on
+ * libandroid.so stops this library from loading at all inside the Winlator
+ * container: the linker eagerly walks its dependency chain, reaches
+ * /system/lib64/libsqlite.so, and resolves that library's OpenSSL imports
+ * against the container's libcrypto, which does not have them.  Winlator's own
+ * Vulkan ICD dlsym's these entry points for the same reason.
+ *
+ * Failing to find them is not fatal: the caller falls back to allocating from
+ * a dma-buf heap, which the GPU is perfectly happy with even though a
+ * compositor will not take it.
+ */
+static struct {
+   int (*allocate)(const AHardwareBuffer_Desc *desc, AHardwareBuffer **out);
+   void (*describe)(const AHardwareBuffer *buffer, AHardwareBuffer_Desc *desc);
+   void (*release)(AHardwareBuffer *buffer);
+   const native_handle_t *(*get_native_handle)(const AHardwareBuffer *buffer);
+   int (*send_handle)(const AHardwareBuffer *buffer, int fd);
+} ahb;
+
+static void *
+ahb_sym(void *const *libs, unsigned nlibs, const char *name)
+{
+   for (unsigned i = 0; i < nlibs; i++) {
+      void *sym = dlsym(libs[i], name);
+      if (sym)
+         return sym;
+   }
+
+   WARN_MSG("no %s in any AHardwareBuffer provider", name);
+   return NULL;
+}
+
+static void
+ahb_load_once(void)
+{
+   static const char *const names[] = {
+      /* Where these actually live.  Tried first because libandroid.so merely
+       * forwards to it while pulling in a far larger dependency chain -- one
+       * bionic cannot satisfy inside the Winlator container, where
+       * /system/lib64/libsqlite.so resolves its OpenSSL imports against the
+       * container's libcrypto and comes up short.
+       */
+      "libnativewindow.so",
+      /* Still worth a try: it is the only place the NDK stub carries
+       * getNativeHandle(), which is a VNDK entry point.
+       */
+      "libandroid.so",
+   };
+   void *libs[ARRAY_SIZE(names)];
+   unsigned nlibs = 0;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(names); i++) {
+      /* Either one missing is unremarkable -- only having neither is a
+       * problem, and ahb_available() reports that below.
+       */
+      void *lib = dlopen(names[i], RTLD_LAZY | RTLD_LOCAL);
+
+      if (lib)
+         libs[nlibs++] = lib;
+   }
+
+   if (!nlibs) {
+      WARN_MSG("no AHardwareBuffer provider; shared images unavailable");
+      return;
+   }
+
+   ahb.describe = (void (*)(const AHardwareBuffer *, AHardwareBuffer_Desc *))ahb_sym(libs, nlibs, "AHardwareBuffer_describe");
+   ahb.release = (void (*)(AHardwareBuffer *))ahb_sym(libs, nlibs, "AHardwareBuffer_release");
+   ahb.get_native_handle = (const native_handle_t *(*)(const AHardwareBuffer *))ahb_sym(libs, nlibs, "AHardwareBuffer_getNativeHandle");
+   ahb.send_handle = (int (*)(const AHardwareBuffer *, int))ahb_sym(libs, nlibs, "AHardwareBuffer_sendHandleToUnixSocket");
+
+   /* Set last: it is what ahb_available() tests, so a half-resolved table
+    * never looks usable.
+    */
+   if (ahb.describe && ahb.release && ahb.get_native_handle && ahb.send_handle)
+      ahb.allocate = (int (*)(const AHardwareBuffer_Desc *, AHardwareBuffer **))ahb_sym(libs, nlibs, "AHardwareBuffer_allocate");
+}
+
+static bool
+ahb_available(void)
+{
+   static util_once_flag once = UTIL_ONCE_FLAG_INIT;
+
+   util_call_once(&once, ahb_load_once);
+
+   return ahb.allocate != NULL;
+}
+#endif
+
+static uint64_t
+kgsl_bo_iova(struct fd_bo *bo)
+{
+   return to_kgsl_bo(bo)->iova;
+}
+
+static void
+kgsl_bo_set_name(struct fd_bo *bo, const char *fmt, va_list ap)
+{
+   /* kgsl has no equivalent of MSM_INFO_SET_NAME */
+}
+
+static int
+kgsl_bo_offset(struct fd_bo *bo, uint64_t *offset)
+{
+   /* The mmap offset of a kgsl allocation is its id shifted over by 12. */
+   *offset = (uint64_t)bo->handle << 12;
+   return 0;
+}
+
+static int
+kgsl_bo_madvise(struct fd_bo *bo, int willneed)
+{
+   /* kgsl has no madvise ioctl, so pretend the kernel kept the pages. */
+   return willneed;
+}
+
+static int
+kgsl_bo_cpu_prep(struct fd_bo *bo, struct fd_pipe *pipe, uint32_t op)
+{
+   /* Only implicit sync needs handling here, which is a no-op for kgsl. */
+   return 0;
+}
+
+static void *
+kgsl_bo_map(struct fd_bo *bo)
+{
+   struct kgsl_bo *kgsl_bo = to_kgsl_bo(bo);
+
+   if (bo->map)
+      return bo->map;
+
+   void *map;
+   if (kgsl_bo->bo_type == KGSL_BO_IMPORT) {
+      /* An imported BO is mapped through the dma-buf itself, not through
+       * the kgsl device node.
+       */
+      map = os_mmap(NULL, bo->size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                    kgsl_bo->import_fd, 0);
+   } else {
+      uint64_t offset;
+
+      if (bo->funcs->offset(bo, &offset))
+         return NULL;
+
+      map = os_mmap(NULL, bo->size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                    bo->dev->fd, offset);
+   }
+
+   if (map == MAP_FAILED) {
+      ERROR_MSG("mmap failed: %s", strerror(errno));
+      return NULL;
+   }
+
+   bo->map = map;
+
+   return bo->map;
+}
+
+#if DETECT_OS_ANDROID
+/**
+ * Winlator's X server does not accept a dma-buf for DRI3 PixmapFromBuffer(s).
+ * It treats the ancillary fd as a socketpair: it writes one handshake byte to
+ * it and then blocks in AHardwareBuffer_recvHandleFromUnixSocket().  So hand
+ * over one end of a socketpair with the handle already queued on it.
+ *
+ * Queueing the handle here, before the request that carries the fd has even
+ * been sent, is what keeps this from deadlocking.  SCM_RIGHTS data is buffered
+ * in the socket, so the server finds it waiting instead of stalling its whole
+ * request thread on a reply we could not send while blocked ourselves.
+ *
+ * Our end stays open: the server's handshake write takes EPIPE and the import
+ * fails if nobody holds the other side.
+ */
+static int
+kgsl_bo_send_ahb(struct kgsl_bo *kgsl_bo)
+{
+   int sv[2];
+
+   if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) < 0) {
+      ERROR_MSG("socketpair failed (%s)", strerror(errno));
+      return -1;
+   }
+
+   if (ahb.send_handle(kgsl_bo->ahb, sv[0])) {
+      ERROR_MSG("could not queue the AHardwareBuffer handle");
+      close(sv[0]);
+      close(sv[1]);
+      return -1;
+   }
+
+   /* A BO can be asked for a handle more than once; the pixmap built from the
+    * previous one is gone by then, so only the newest sender end matters.
+    */
+   if (kgsl_bo->handshake_fd >= 0)
+      close(kgsl_bo->handshake_fd);
+   kgsl_bo->handshake_fd = sv[0];
+
+   return sv[1];
+}
+#endif
+
+static int
+kgsl_bo_dmabuf(struct fd_bo *bo)
+{
+   struct kgsl_bo *kgsl_bo = to_kgsl_bo(bo);
+
+#if DETECT_OS_ANDROID
+   if (kgsl_bo->ahb)
+      return kgsl_bo_send_ahb(kgsl_bo);
+#endif
+
+   /* kgsl has no export ioctl: a BO is only shareable if it was created
+    * from a dma-buf in the first place, in which case "exporting" it is
+    * just handing back another reference to that dma-buf.
+    */
+   if (kgsl_bo->bo_type != KGSL_BO_IMPORT || kgsl_bo->import_fd < 0) {
+      ERROR_MSG("cannot export a natively allocated kgsl buffer");
+      return -1;
+   }
+
+   return os_dupfd_cloexec(kgsl_bo->import_fd);
+}
+
+void
+kgsl_bo_close_handle(struct fd_bo *bo)
+{
+   struct kgsl_bo *kgsl_bo = to_kgsl_bo(bo);
+
+   if (kgsl_bo->import_fd >= 0) {
+      close(kgsl_bo->import_fd);
+      kgsl_bo->import_fd = -1;
+   }
+
+   if (kgsl_bo->handshake_fd >= 0) {
+      close(kgsl_bo->handshake_fd);
+      kgsl_bo->handshake_fd = -1;
+   }
+
+#if DETECT_OS_ANDROID
+   if (kgsl_bo->ahb) {
+      ahb.release(kgsl_bo->ahb);
+      kgsl_bo->ahb = NULL;
+   }
+#endif
+
+   struct kgsl_gpumem_free_id req = {
+      .id = bo->handle,
+   };
+
+   kgsl_safe_ioctl(bo->dev->fd, IOCTL_KGSL_GPUMEM_FREE_ID, &req);
+}
+
+static void
+kgsl_bo_destroy(struct fd_bo *bo)
+{
+   /* kgsl frees the allocation as soon as the id is released, with no
+    * regard for whether the GPU is still reading it.  There is no
+    * deferred-free or madvise mechanism to lean on, so wait out every
+    * fence the BO is referenced by before letting it go.
+    */
+   for (uint32_t i = 0; i < bo->nr_fences; i++) {
+      struct fd_pipe *pipe = bo->fences[i]->pipe;
+      pipe->funcs->wait(pipe, bo->fences[i], OS_TIMEOUT_INFINITE);
+   }
+
+   fd_bo_fini_common(bo);
+}
+
+static const struct fd_bo_funcs bo_funcs = {
+   .offset = kgsl_bo_offset,
+   .map = kgsl_bo_map,
+   .cpu_prep = kgsl_bo_cpu_prep,
+   .madvise = kgsl_bo_madvise,
+   .iova = kgsl_bo_iova,
+   .set_name = kgsl_bo_set_name,
+   .dmabuf = kgsl_bo_dmabuf,
+   .destroy = kgsl_bo_destroy,
+};
+
+/**
+ * Wrap an already-created kgsl allocation id in an fd_bo.
+ */
+static struct fd_bo *
+kgsl_bo_alloc(struct fd_device *dev, uint32_t size, uint32_t handle,
+              uint64_t iova, int import_fd)
+{
+   struct kgsl_bo *kgsl_bo = calloc(1, sizeof(*kgsl_bo));
+   if (!kgsl_bo)
+      return NULL;
+
+   struct fd_bo *bo = &kgsl_bo->base;
+   bo->size = size;
+   bo->handle = handle;
+   bo->funcs = &bo_funcs;
+
+   kgsl_bo->iova = iova;
+   kgsl_bo->import_fd = import_fd;
+   kgsl_bo->handshake_fd = -1;
+   kgsl_bo->bo_type = import_fd >= 0 ? KGSL_BO_IMPORT : KGSL_BO_NATIVE;
+
+   fd_bo_init_common(bo, dev);
+
+   return bo;
+}
+
+/* Note: size is ignored, as kgsl knows the real size of the allocation. */
+struct fd_bo *
+kgsl_bo_from_handle(struct fd_device *dev, uint32_t size, uint32_t handle)
+{
+   struct kgsl_gpuobj_info req = {
+      .id = handle,
+   };
+
+   if (kgsl_safe_ioctl(dev->fd, IOCTL_KGSL_GPUOBJ_INFO, &req)) {
+      ERROR_MSG("GPUOBJ_INFO failed (%s)", strerror(errno));
+      return NULL;
+   }
+
+   return kgsl_bo_alloc(dev, req.size, req.id, req.gpuaddr, -1);
+}
+
+struct fd_bo *
+kgsl_bo_from_dmabuf(struct fd_device *dev, int fd)
+{
+   struct kgsl_gpuobj_import_dma_buf import_dmabuf = {
+      .fd = fd,
+   };
+   struct kgsl_gpuobj_import req = {
+      .priv = (uintptr_t)&import_dmabuf,
+      .priv_len = sizeof(import_dmabuf),
+      .flags = 0,
+      .type = KGSL_USER_MEM_TYPE_DMABUF,
+   };
+
+   if (kgsl_safe_ioctl(dev->fd, IOCTL_KGSL_GPUOBJ_IMPORT, &req)) {
+      ERROR_MSG("GPUOBJ_IMPORT failed (%s)", strerror(errno));
+      return NULL;
+   }
+
+   /* The import ioctl only hands back an id, so the size and iova still
+    * have to be queried separately.
+    */
+   struct kgsl_gpuobj_info info = {
+      .id = req.id,
+   };
+
+   if (kgsl_safe_ioctl(dev->fd, IOCTL_KGSL_GPUOBJ_INFO, &info)) {
+      ERROR_MSG("GPUOBJ_INFO failed for imported dma-buf (%s)",
+                strerror(errno));
+      goto fail_free_id;
+   }
+
+   int import_fd = os_dupfd_cloexec(fd);
+   if (import_fd < 0) {
+      ERROR_MSG("failed to dup dma-buf fd (%s)", strerror(errno));
+      goto fail_free_id;
+   }
+
+   struct fd_bo *bo =
+      kgsl_bo_alloc(dev, info.size, req.id, info.gpuaddr, import_fd);
+   if (!bo) {
+      close(import_fd);
+      goto fail_free_id;
+   }
+
+   return bo;
+
+fail_free_id: {
+   struct kgsl_gpumem_free_id free_req = {
+      .id = req.id,
+   };
+   kgsl_safe_ioctl(dev->fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req);
+   return NULL;
+}
+}
+
+/**
+ * kgsl cannot allocate dma-bufs itself, so shareable buffers are allocated
+ * from a dma-buf heap (or ION on older kernels) and then imported.
+ */
+static int
+kgsl_dma_heap_alloc(struct kgsl_device *kgsl_dev, uint32_t size)
+{
+   int ret;
+
+   switch (kgsl_dev->dma_type) {
+   case KGSL_DMA_TYPE_DMAHEAP: {
+      struct dma_heap_allocation_data alloc = {
+         .len = size,
+         .fd_flags = O_RDWR | O_CLOEXEC,
+      };
+
+      ret = kgsl_safe_ioctl(kgsl_dev->dma_fd, DMA_HEAP_IOCTL_ALLOC, &alloc);
+      if (ret) {
+         ERROR_MSG("DMA_HEAP_IOCTL_ALLOC failed (%s)", strerror(errno));
+         return -1;
+      }
+
+      return alloc.fd;
+   }
+
+   case KGSL_DMA_TYPE_ION: {
+      struct ion_new_allocation_data alloc = {
+         .len = size,
+         .heap_id_mask = KGSL_ION_SYSTEM_HEAP_MASK,
+         .flags = 0,
+         .fd = -1,
+      };
+
+      ret = kgsl_safe_ioctl(kgsl_dev->dma_fd, ION_IOC_NEW_ALLOC, &alloc);
+      if (ret) {
+         ERROR_MSG("ION_IOC_NEW_ALLOC failed (%s)", strerror(errno));
+         return -1;
+      }
+
+      return alloc.fd;
+   }
+
+   case KGSL_DMA_TYPE_ION_LEGACY: {
+      struct ion_allocation_data alloc = {
+         .len = size,
+         .align = 4096,
+         .heap_id_mask = KGSL_ION_SYSTEM_HEAP_MASK,
+         .flags = 0,
+      };
+
+      ret = kgsl_safe_ioctl(kgsl_dev->dma_fd, ION_IOC_ALLOC, &alloc);
+      if (ret) {
+         ERROR_MSG("ION_IOC_ALLOC failed (%s)", strerror(errno));
+         return -1;
+      }
+
+      struct ion_fd_data share = {
+         .handle = alloc.handle,
+      };
+
+      ret = kgsl_safe_ioctl(kgsl_dev->dma_fd, ION_IOC_SHARE, &share);
+      if (ret) {
+         ERROR_MSG("ION_IOC_SHARE failed (%s)", strerror(errno));
+         return -1;
+      }
+
+      return share.fd;
+   }
+
+   case KGSL_DMA_TYPE_NONE:
+   default:
+      ERROR_MSG("no dma-buf heap available, cannot allocate a shared buffer");
+      return -1;
+   }
+}
+
+static struct fd_bo *
+kgsl_bo_new_dmabuf(struct fd_device *dev, uint32_t size)
+{
+   struct kgsl_device *kgsl_dev = to_kgsl_device(dev);
+
+   int fd = kgsl_dma_heap_alloc(kgsl_dev, size);
+   if (fd < 0)
+      return NULL;
+
+   /* kgsl_bo_from_dmabuf() keeps a dup of its own, so the fd is ours to
+    * close either way.
+    */
+   struct fd_bo *bo = kgsl_bo_from_dmabuf(dev, fd);
+   close(fd);
+
+   return bo;
+}
+
+#if DETECT_OS_ANDROID
+static uint32_t
+ahb_format_from_fourcc(uint32_t fourcc, uint32_t *cpp)
+{
+   *cpp = 4;
+
+   switch (fourcc) {
+   case DRM_FORMAT_ABGR8888:
+      return AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+   case DRM_FORMAT_XBGR8888:
+      return AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM;
+   case DRM_FORMAT_ARGB8888:
+   case DRM_FORMAT_XRGB8888:
+      return HAL_PIXEL_FORMAT_BGRA_8888;
+   case DRM_FORMAT_RGB565:
+      *cpp = 2;
+      return AHARDWAREBUFFER_FORMAT_R5G6B5_UNORM;
+   default:
+      return 0;
+   }
+}
+
+struct fd_bo *
+kgsl_bo_new_shared_image(struct fd_device *dev, uint32_t width, uint32_t height,
+                         uint32_t fourcc, uint32_t *pitch)
+{
+   uint32_t cpp;
+   uint32_t format = ahb_format_from_fourcc(fourcc, &cpp);
+
+   /* Not an error: the caller falls back to an ordinary allocation. */
+   if (!format)
+      return NULL;
+
+   if (!ahb_available())
+      return NULL;
+
+   /* fdl6_layout_image() rounds the last level's height up to a multiple of
+    * four, because the mem<->gmem blits work at a 16x4 granularity and
+    * over-fetch past the bottom edge.  It then refuses any buffer smaller than
+    * that, and gralloc has no reason to have left the room: at 632x454 with a
+    * 2560-byte pitch it wants 456 rows, one page more than the 1163264 bytes
+    * gralloc hands back.  Ask for the rows up front rather than be refused and
+    * fall back to a buffer no compositor here will take.
+    *
+    * The cost is that the buffer is a couple of rows taller than the image,
+    * which a consumer sampling it across its full height will show as a very
+    * slight vertical squash.  Correcting that needs the consumer to scale by
+    * height/desc.height, which it cannot do without being told both.
+    */
+   AHardwareBuffer_Desc desc = {
+      .width = width,
+      .height = align(height, 4),
+      .layers = 1,
+      .format = format,
+      /* COMPOSER_OVERLAY is the one that matters beyond rendering: without it
+       * SurfaceFlinger will not take the buffer for direct scanout and falls
+       * back to composing it through the GPU.
+       *
+       * The CPU bits are not for us -- nothing here ever maps this buffer.
+       * They are for the consumer: the X server this targets answers a
+       * CopyArea out of a DRI3 pixmap by locking it for CPU_READ and running
+       * a memcpy, and it presents through the same path when it cannot flip.
+       * A buffer allocated for the GPU alone is still handed back by
+       * AHardwareBuffer_lock() on this gralloc, but the mapping it returns is
+       * not CPU-readable, so the first byte of that memcpy faults with
+       * SEGV_ACCERR and takes the whole server down with it -- which reaches
+       * us only as the X connection dropping mid-request.
+       *
+       * The cost is that gralloc will not pick a compressed or otherwise
+       * CPU-hostile layout, which is what this path wants anyway: it asks for
+       * DRM_FORMAT_MOD_LINEAR and builds the fdl6 layout around the pitch it
+       * gets back.
+       */
+      .usage = AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT |
+               AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+               AHARDWAREBUFFER_USAGE_COMPOSER_OVERLAY |
+               AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN |
+               AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN,
+   };
+
+   AHardwareBuffer *ahbuf = NULL;
+   if (ahb.allocate(&desc, &ahbuf)) {
+      ERROR_MSG("AHardwareBuffer_allocate failed for %ux%u fourcc 0x%08x",
+                width, height, fourcc);
+      return NULL;
+   }
+
+   /* Re-describe: the allocator chose the pitch, and the layout above us has
+    * to be built around it rather than the other way round.
+    */
+   ahb.describe(ahbuf, &desc);
+
+   const native_handle_t *handle = ahb.get_native_handle(ahbuf);
+   if (!handle || handle->numFds < 1) {
+      ERROR_MSG("AHardwareBuffer carries no dma-buf to import");
+      ahb.release(ahbuf);
+      return NULL;
+   }
+
+   /* kgsl_bo_from_dmabuf() dups what it keeps, and the AHardwareBuffer still
+    * owns the fd in the native handle, so neither side has to close it here.
+    */
+   struct fd_bo *bo = kgsl_bo_from_dmabuf(dev, handle->data[0]);
+   if (!bo) {
+      ahb.release(ahbuf);
+      return NULL;
+   }
+
+   to_kgsl_bo(bo)->ahb = ahbuf;
+
+   /* gralloc reports the stride in pixels; every caller wants bytes. */
+   *pitch = desc.stride * cpp;
+
+   return bo;
+}
+#endif
+
+struct fd_bo *
+kgsl_bo_new(struct fd_device *dev, uint32_t size, uint32_t flags)
+{
+   if (flags & (FD_BO_SHARED | FD_BO_SCANOUT))
+      return kgsl_bo_new_dmabuf(dev, size);
+
+   struct kgsl_gpumem_alloc_id req = {
+      .size = size,
+   };
+
+   if (flags & FD_BO_GPUREADONLY)
+      req.flags |= KGSL_MEMFLAGS_GPUREADONLY;
+
+   /* Note that dev->has_cached_coherent is never set for kgsl, so the
+    * common layer strips FD_BO_CACHED_COHERENT before we get here and the
+    * writecombine path is always taken.  Enabling it would need a runtime
+    * probe that KGSL_MEMFLAGS_IOCOHERENT actually works on this kernel.
+    */
+   if (flags & FD_BO_CACHED_COHERENT)
+      req.flags |= KGSL_MEMFLAGS_IOCOHERENT |
+                   (KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT);
+   else
+      req.flags |= KGSL_CACHEMODE_WRITECOMBINE << KGSL_CACHEMODE_SHIFT;
+
+   if (kgsl_safe_ioctl(dev->fd, IOCTL_KGSL_GPUMEM_ALLOC_ID, &req)) {
+      ERROR_MSG("GPUMEM_ALLOC_ID failed (%s)", strerror(errno));
+      return NULL;
+   }
+
+   /* Unlike the import path, ALLOC_ID already reports the address and the
+    * (page aligned) mappable size, so no GPUOBJ_INFO round trip is needed.
+    */
+   struct fd_bo *bo = kgsl_bo_alloc(dev, req.mmapsize, req.id, req.gpuaddr, -1);
+   if (!bo) {
+      struct kgsl_gpumem_free_id free_req = {
+         .id = req.id,
+      };
+      kgsl_safe_ioctl(dev->fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req);
+      return NULL;
+   }
+
+   return bo;
+}
diff --git a/src/freedreno/drm/kgsl/kgsl_device.c b/src/freedreno/drm/kgsl/kgsl_device.c
new file mode 100644
index 00000000000..1b673e12c58
--- /dev/null
+++ b/src/freedreno/drm/kgsl/kgsl_device.c
@@ -0,0 +1,104 @@
+/*
+ * Copyright © 2023 Lucas Fryzek <lfryzek@igalia.com>
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <fcntl.h>
+
+#include "../../vulkan/ion/ion.h"
+#include "../../vulkan/ion/ion_4.19.h"
+
+#include "kgsl_priv.h"
+
+static void
+kgsl_device_destroy(struct fd_device *dev)
+{
+   struct kgsl_device *kgsl_dev = to_kgsl_device(dev);
+
+   if (kgsl_dev->dma_fd >= 0)
+      close(kgsl_dev->dma_fd);
+}
+
+static const struct fd_device_funcs funcs = {
+   .bo_new = kgsl_bo_new,
+#if DETECT_OS_ANDROID
+   .bo_new_shared_image = kgsl_bo_new_shared_image,
+#endif
+   .bo_from_handle = kgsl_bo_from_handle,
+   .bo_from_dmabuf = kgsl_bo_from_dmabuf,
+   .bo_close_handle = kgsl_bo_close_handle,
+   .pipe_new = kgsl_pipe_new,
+   .destroy = kgsl_device_destroy,
+};
+
+/**
+ * kgsl can import dma-bufs but cannot allocate or export them, so shareable
+ * buffers have to come from a dma-buf heap (or ION on older kernels) and then
+ * be imported.  Work out which of those this kernel offers.
+ *
+ * Mirrors the probe in turnip's tu_knl_kgsl.cc.
+ */
+static void
+kgsl_probe_dma_heap(struct kgsl_device *kgsl_dev)
+{
+   static const char dma_heap_path[] = "/dev/dma_heap/system";
+   static const char ion_path[] = "/dev/ion";
+
+   kgsl_dev->dma_fd = open(dma_heap_path, O_RDONLY | O_CLOEXEC);
+   if (kgsl_dev->dma_fd >= 0) {
+      kgsl_dev->dma_type = KGSL_DMA_TYPE_DMAHEAP;
+      return;
+   }
+
+   kgsl_dev->dma_fd = open(ion_path, O_RDONLY | O_CLOEXEC);
+   if (kgsl_dev->dma_fd >= 0) {
+      /* ION_IOC_FREE is only available on legacy ION: */
+      struct ion_handle_data free = { .handle = 0 };
+      if (kgsl_safe_ioctl(kgsl_dev->dma_fd, ION_IOC_FREE, &free) >= 0 ||
+          errno != ENOTTY)
+         kgsl_dev->dma_type = KGSL_DMA_TYPE_ION_LEGACY;
+      else
+         kgsl_dev->dma_type = KGSL_DMA_TYPE_ION;
+      return;
+   }
+
+   kgsl_dev->dma_type = KGSL_DMA_TYPE_NONE;
+   INFO_MSG("could not open %s or %s, shared buffers will be unavailable: %s",
+            dma_heap_path, ion_path, strerror(errno));
+}
+
+struct fd_device *
+kgsl_device_new(int fd)
+{
+   struct kgsl_device *kgsl_dev;
+   struct fd_device *dev;
+   struct kgsl_devinfo info;
+
+   /* Probe the device info to check whether this fd really is kgsl.  This is
+    * the only thing distinguishing it from an arbitrary character device,
+    * since kgsl answers no DRM ioctl.
+    */
+   if (kgsl_get_prop(fd, KGSL_PROP_DEVICE_INFO, &info, sizeof(info)))
+      return NULL;
+
+   kgsl_dev = calloc(1, sizeof(*kgsl_dev));
+   if (!kgsl_dev)
+      return NULL;
+
+   dev = &kgsl_dev->base;
+   dev->funcs = &funcs;
+   dev->fd = fd;
+   dev->version = FD_VERSION_ROBUSTNESS;
+   dev->features = FD_FEATURE_DIRECT_RESET | FD_FEATURE_IMPORT_DMABUF;
+#if DETECT_OS_ANDROID
+   dev->features |= FD_FEATURE_SHARED_IMAGE;
+#endif
+   dev->bo_size = sizeof(struct kgsl_bo);
+
+   kgsl_probe_dma_heap(kgsl_dev);
+
+   /* async submit_queue used for softpin deferred submits */
+   util_queue_init(&dev->submit_queue, "sq", 8, 1, 0, NULL);
+
+   return dev;
+}
diff --git a/src/freedreno/drm/kgsl/kgsl_pipe.c b/src/freedreno/drm/kgsl/kgsl_pipe.c
new file mode 100644
index 00000000000..6be6f0c84b6
--- /dev/null
+++ b/src/freedreno/drm/kgsl/kgsl_pipe.c
@@ -0,0 +1,268 @@
+/*
+ * Copyright © 2023 Lucas Fryzek <lfryzek@igalia.com>
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "util/os_time.h"
+
+#include "freedreno_ringbuffer_sp.h"
+
+#include "kgsl_priv.h"
+
+/* TODO borrowed from turnip, should be shared somewhere common. */
+int
+kgsl_safe_ioctl(int fd, unsigned long request, void *arg)
+{
+   int ret;
+
+   do {
+      ret = ioctl(fd, request, arg);
+   } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
+
+   return ret;
+}
+
+/**
+ * Convert an absolute deadline in nanoseconds into the relative millisecond
+ * timeout the kgsl wait ioctl expects.
+ *
+ * As in turnip, -1 means "wait forever": it is the highest unsigned value
+ * for the wait ioctl.
+ */
+static int
+get_relative_ms(uint64_t abs_timeout_ns)
+{
+   if (abs_timeout_ns >= INT64_MAX)
+      return -1;
+
+   uint64_t cur_time_ms = os_time_get_nano() / 1000000;
+   uint64_t abs_timeout_ms = abs_timeout_ns / 1000000;
+
+   if (abs_timeout_ms <= cur_time_ms)
+      return 0;
+
+   return abs_timeout_ms - cur_time_ms;
+}
+
+/* TODO borrowed from turnip, should be shared somewhere common.
+ * kgsl_safe_ioctl() is not enough here: a restarted wait has to have its
+ * timeout adjusted, or we could wait substantially longer than asked.
+ */
+static int
+wait_timestamp_safe(int fd, unsigned int context_id, unsigned int timestamp,
+                    uint64_t abs_timeout_ns)
+{
+   struct kgsl_device_waittimestamp_ctxtid wait = {
+      .context_id = context_id,
+      .timestamp = timestamp,
+      .timeout = get_relative_ms(abs_timeout_ns),
+   };
+
+   while (true) {
+      int ret = ioctl(fd, IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID, &wait);
+
+      if (ret == -1 && (errno == EINTR || errno == EAGAIN)) {
+         int timeout_ms = get_relative_ms(abs_timeout_ns);
+
+         if (timeout_ms == 0) {
+            errno = ETIMEDOUT;
+            return -1;
+         }
+
+         wait.timeout = timeout_ms;
+      } else {
+         return ret;
+      }
+   }
+}
+
+int
+kgsl_get_prop(int fd, unsigned int type, void *value, size_t size)
+{
+   struct kgsl_device_getproperty getprop = {
+      .type = type,
+      .value = value,
+      .sizebytes = size,
+   };
+
+   return kgsl_safe_ioctl(fd, IOCTL_KGSL_DEVICE_GETPROPERTY, &getprop);
+}
+
+static int
+kgsl_pipe_get_param(struct fd_pipe *pipe, enum fd_param_id param,
+                    uint64_t *value)
+{
+   struct kgsl_pipe *kgsl_pipe = to_kgsl_pipe(pipe);
+
+   switch (param) {
+   case FD_DEVICE_ID:
+   case FD_GPU_ID:
+      *value = kgsl_pipe->dev_id.gpu_id;
+      return 0;
+   case FD_GMEM_SIZE:
+      *value = kgsl_pipe->gmem_size;
+      return 0;
+   case FD_GMEM_BASE:
+      *value = kgsl_pipe->gmem_base;
+      return 0;
+   case FD_CHIP_ID:
+      *value = kgsl_pipe->dev_id.chip_id;
+      return 0;
+   case FD_NR_PRIORITIES:
+      /* Taken from the kgsl kmd sources: a4xx and newer have
+       * KGSL_PRIORITY_MAX_RB_LEVELS=4 priorities, older ones just one.
+       */
+      *value = kgsl_pipe->dev_id.gpu_id >= 400 ? 4 : 1;
+      return 0;
+   case FD_MAX_FREQ:
+   case FD_TIMESTAMP:
+      /* Fail these explicitly rather than falling through to the default
+       * case: there is no way to convert a kgsl timestamp into a time
+       * value, so this is an unsupported feature and not an error worth
+       * logging on every call.
+       */
+      return -1;
+   default:
+      ERROR_MSG("invalid param id: %d", param);
+      return -1;
+   }
+}
+
+static int
+kgsl_pipe_set_param(struct fd_pipe *pipe, enum fd_param_id param,
+                    uint64_t value)
+{
+   ERROR_MSG("invalid param id: %d", param);
+   return -1;
+}
+
+static int
+kgsl_pipe_wait(struct fd_pipe *pipe, const struct fd_fence *fence,
+               uint64_t timeout)
+{
+   struct kgsl_pipe *kgsl_pipe = to_kgsl_pipe(pipe);
+
+   /* fd_pipe_wait() hands us a relative timeout in nanoseconds, while the
+    * helper below works on an absolute deadline (so restarted waits do not
+    * extend it).
+    */
+   return wait_timestamp_safe(pipe->dev->fd, kgsl_pipe->queue_id,
+                              fence->kfence,
+                              os_time_get_absolute_timeout(timeout));
+}
+
+static int
+kgsl_pipe_reset_status(struct fd_pipe *pipe, enum fd_reset_status *status)
+{
+   struct kgsl_pipe *kgsl_pipe = to_kgsl_pipe(pipe);
+
+   /* The context id is passed in, and the reset status comes back out, in
+    * the same word.
+    */
+   uint32_t value = kgsl_pipe->queue_id;
+
+   int ret = kgsl_get_prop(pipe->dev->fd, KGSL_PROP_GPU_RESET_STAT, &value,
+                           sizeof(value));
+   if (ret)
+      return ret;
+
+   switch (value) {
+   case KGSL_CTX_STAT_NO_ERROR:
+      *status = FD_RESET_NO_ERROR;
+      break;
+   case KGSL_CTX_STAT_GUILTY_CONTEXT_RESET_EXT:
+      *status = FD_RESET_GUILTY;
+      break;
+   case KGSL_CTX_STAT_INNOCENT_CONTEXT_RESET_EXT:
+      *status = FD_RESET_INNOCENT;
+      break;
+   case KGSL_CTX_STAT_UNKNOWN_CONTEXT_RESET_EXT:
+   default:
+      *status = FD_RESET_UNKNOWN;
+      break;
+   }
+
+   return 0;
+}
+
+static void
+kgsl_pipe_destroy(struct fd_pipe *pipe)
+{
+   struct kgsl_pipe *kgsl_pipe = to_kgsl_pipe(pipe);
+   struct kgsl_drawctxt_destroy req = {
+      .drawctxt_id = kgsl_pipe->queue_id,
+   };
+
+   fd_pipe_sp_ringpool_fini(pipe);
+   kgsl_safe_ioctl(pipe->dev->fd, IOCTL_KGSL_DRAWCTXT_DESTROY, &req);
+
+   free(kgsl_pipe);
+}
+
+static const struct fd_pipe_funcs funcs = {
+   .ringbuffer_new_object = fd_ringbuffer_sp_new_object,
+   .submit_new = kgsl_submit_sp_new,
+   .reset_status = kgsl_pipe_reset_status,
+   .flush = fd_pipe_sp_flush,
+   .get_param = kgsl_pipe_get_param,
+   .set_param = kgsl_pipe_set_param,
+   .wait = kgsl_pipe_wait,
+   .destroy = kgsl_pipe_destroy,
+};
+
+struct fd_pipe *
+kgsl_pipe_new(struct fd_device *dev, enum fd_pipe_id id, unsigned prio)
+{
+   struct kgsl_pipe *kgsl_pipe = calloc(1, sizeof(*kgsl_pipe));
+   if (!kgsl_pipe) {
+      ERROR_MSG("allocation failed");
+      return NULL;
+   }
+
+   struct fd_pipe *pipe = &kgsl_pipe->base;
+   pipe->dev = dev;
+   pipe->funcs = &funcs;
+
+   struct kgsl_devinfo info;
+   if (kgsl_get_prop(dev->fd, KGSL_PROP_DEVICE_INFO, &info, sizeof(info))) {
+      ERROR_MSG("KGSL_PROP_DEVICE_INFO failed (%s)", strerror(errno));
+      goto fail;
+   }
+
+   uint64_t gmem_iova;
+   if (kgsl_get_prop(dev->fd, KGSL_PROP_UCHE_GMEM_VADDR, &gmem_iova,
+                     sizeof(gmem_iova))) {
+      ERROR_MSG("KGSL_PROP_UCHE_GMEM_VADDR failed (%s)", strerror(errno));
+      goto fail;
+   }
+
+   kgsl_pipe->dev_id.gpu_id = ((info.chip_id >> 24) & 0xff) * 100 +
+                              ((info.chip_id >> 16) & 0xff) * 10 +
+                              ((info.chip_id >> 8) & 0xff);
+   kgsl_pipe->dev_id.chip_id = info.chip_id;
+   kgsl_pipe->gmem_size = info.gmem_sizebytes;
+   kgsl_pipe->gmem_base = gmem_iova;
+
+   struct kgsl_drawctxt_create req = {
+      .flags = KGSL_CONTEXT_SAVE_GMEM | KGSL_CONTEXT_NO_GMEM_ALLOC |
+               KGSL_CONTEXT_PREAMBLE,
+   };
+
+   if (kgsl_safe_ioctl(dev->fd, IOCTL_KGSL_DRAWCTXT_CREATE, &req)) {
+      ERROR_MSG("DRAWCTXT_CREATE failed (%s)", strerror(errno));
+      goto fail;
+   }
+
+   kgsl_pipe->queue_id = req.drawctxt_id;
+
+   fd_pipe_sp_ringpool_init(pipe);
+
+   return pipe;
+
+fail:
+   /* The drawctxt is only created as the last step, so nothing has been
+    * handed to the kernel yet at this point.
+    */
+   free(kgsl_pipe);
+   return NULL;
+}
diff --git a/src/freedreno/drm/kgsl/kgsl_priv.h b/src/freedreno/drm/kgsl/kgsl_priv.h
new file mode 100644
index 00000000000..deed6c0a839
--- /dev/null
+++ b/src/freedreno/drm/kgsl/kgsl_priv.h
@@ -0,0 +1,105 @@
+/*
+ * Copyright © 2023 Lucas Fryzek <lfryzek@igalia.com>
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KGSL_PRIV_H_
+#define KGSL_PRIV_H_
+
+#include "freedreno_priv.h"
+
+#ifndef __user
+#define __user
+#endif
+
+/* TODO the KGSL kernel interface should probably be moved into someplace
+ * common that both turnip and freedreno can use, rather than reaching into
+ * the vulkan driver like this.
+ */
+#include "../../vulkan/msm_kgsl.h"
+
+/* ION_HEAP_SYSTEM, as used by the downstream msm ION driver. */
+#define KGSL_ION_SYSTEM_HEAP_MASK (1u << 25)
+
+/**
+ * Which ABI the kernel offers for allocating the shareable (dma-buf backed)
+ * memory that kgsl itself cannot allocate.  Probed once at device creation.
+ */
+enum kgsl_dma_type {
+   KGSL_DMA_TYPE_NONE = 0,
+   KGSL_DMA_TYPE_DMAHEAP,
+   KGSL_DMA_TYPE_ION,
+   KGSL_DMA_TYPE_ION_LEGACY,
+};
+
+struct kgsl_device {
+   struct fd_device base;
+
+   /* fd of /dev/dma_heap/system or /dev/ion, or -1 if neither is available.
+    * Kept open for the lifetime of the device rather than reopened per
+    * allocation.
+    */
+   int dma_fd;
+   enum kgsl_dma_type dma_type;
+};
+FD_DEFINE_CAST(fd_device, kgsl_device);
+
+struct fd_device *kgsl_device_new(int fd);
+
+struct kgsl_pipe {
+   struct fd_pipe base;
+
+   struct fd_dev_id dev_id;
+
+   uint32_t gmem_size;
+   uint64_t gmem_base;
+   uint32_t queue_id;
+};
+FD_DEFINE_CAST(fd_pipe, kgsl_pipe);
+
+struct fd_pipe *kgsl_pipe_new(struct fd_device *dev, enum fd_pipe_id id,
+                              unsigned prio);
+
+struct kgsl_bo {
+   struct fd_bo base;
+   uint64_t iova;
+
+   /* For KGSL_BO_IMPORT, the dma-buf fd backing this BO.  kgsl has no
+    * export ioctl, so this is also what fd_bo_dmabuf() hands out.  -1 for
+    * natively allocated BOs, which are simply not shareable.
+    */
+   int import_fd;
+
+   /* Set when the BO came from kgsl_bo_new_shared_image(): the
+    * AHardwareBuffer whose dma-buf was imported.  Typed void * so the
+    * NDK headers stay out of this one.
+    */
+   void *ahb;
+
+   /* Our end of the socketpair fd_bo_dmabuf() last handed out for an AHB.
+    * Held open because the receiver writes a handshake byte back down it.
+    */
+   int handshake_fd;
+
+   enum {
+      KGSL_BO_NATIVE,
+      KGSL_BO_IMPORT,
+   } bo_type;
+};
+FD_DEFINE_CAST(fd_bo, kgsl_bo);
+
+struct fd_bo *kgsl_bo_new(struct fd_device *dev, uint32_t size, uint32_t flags);
+struct fd_bo *kgsl_bo_new_shared_image(struct fd_device *dev, uint32_t width,
+                                       uint32_t height, uint32_t fourcc,
+                                       uint32_t *pitch);
+struct fd_bo *kgsl_bo_from_handle(struct fd_device *dev, uint32_t size,
+                                  uint32_t handle);
+struct fd_bo *kgsl_bo_from_dmabuf(struct fd_device *dev, int fd);
+void kgsl_bo_close_handle(struct fd_bo *bo);
+
+struct fd_submit *kgsl_submit_sp_new(struct fd_pipe *pipe);
+
+int kgsl_safe_ioctl(int fd, unsigned long request, void *arg);
+int kgsl_get_prop(int fd, unsigned int type, void *value, size_t size);
+
+#endif /* KGSL_PRIV_H_ */
diff --git a/src/freedreno/drm/kgsl/kgsl_ringbuffer_sp.c b/src/freedreno/drm/kgsl/kgsl_ringbuffer_sp.c
new file mode 100644
index 00000000000..68c6af8fc37
--- /dev/null
+++ b/src/freedreno/drm/kgsl/kgsl_ringbuffer_sp.c
@@ -0,0 +1,138 @@
+/*
+ * Copyright © 2023 Lucas Fryzek <lfryzek@igalia.com>
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "freedreno_ringbuffer_sp.h"
+
+#include "kgsl_priv.h"
+
+/**
+ * kgsl has no sync_file support in the submit ioctl itself.  An out fence fd
+ * is obtained after the fact, by registering a fence event on the timestamp
+ * the submit returned.
+ */
+static int
+timestamp_to_fd(struct fd_pipe *pipe, uint32_t timestamp)
+{
+   int fd = -1;
+   struct kgsl_pipe *kgsl_pipe = to_kgsl_pipe(pipe);
+   struct kgsl_timestamp_event event = {
+      .type = KGSL_TIMESTAMP_EVENT_FENCE,
+      .context_id = kgsl_pipe->queue_id,
+      .timestamp = timestamp,
+      .priv = &fd,
+      .len = sizeof(fd),
+   };
+
+   if (kgsl_safe_ioctl(pipe->dev->fd, IOCTL_KGSL_TIMESTAMP_EVENT, &event))
+      return -1;
+
+   return fd;
+}
+
+static int
+flush_submit_list(struct list_head *submit_list)
+{
+   struct fd_submit_sp *fd_submit = to_fd_submit_sp(last_submit(submit_list));
+   struct fd_pipe *pipe = fd_submit->base.pipe;
+   struct kgsl_pipe *kgsl_pipe = to_kgsl_pipe(pipe);
+   unsigned nr_cmds = 0;
+
+   MESA_TRACE_FUNC();
+
+   /* Determine the number of extra cmds's from deferred submits that
+    * we will be merging in:
+    */
+   foreach_submit (submit, submit_list) {
+      assert(submit->pipe == &kgsl_pipe->base);
+      nr_cmds += to_fd_ringbuffer_sp(submit->primary)->u.nr_cmds;
+   }
+
+   struct kgsl_command_object cmds[nr_cmds];
+   unsigned cmd_idx = 0;
+
+   /* Build up the table of cmds.  Unlike msm there is no separate bo table
+    * to index into: kgsl submits take the gpu address directly.  The ring
+    * bos are still referenced by the common flush_prep(), which is what
+    * attaches the out fence to them.
+    */
+   foreach_submit_safe (submit, submit_list) {
+      struct fd_ringbuffer_sp *deferred_primary =
+         to_fd_ringbuffer_sp(submit->primary);
+
+      for (unsigned i = 0; i < deferred_primary->u.nr_cmds; i++) {
+         struct fd_bo *ring_bo = deferred_primary->u.cmds[i].ring_bo;
+
+         cmds[cmd_idx++] = (struct kgsl_command_object) {
+            .offset = 0,
+            .gpuaddr = ring_bo->iova +
+                       submit_offset(ring_bo, deferred_primary->offset),
+            .size = deferred_primary->u.cmds[i].size,
+            .flags = KGSL_CMDLIST_IB,
+            .id = ring_bo->handle,
+         };
+      }
+
+      if (submit == last_submit(submit_list)) {
+         DEBUG_MSG("merged %u submits", cmd_idx);
+         break;
+      }
+
+      list_del(&submit->node);
+      fd_submit_del(submit);
+   }
+
+   struct kgsl_cmd_syncpoint_fence sync_fence = {
+      .fd = fd_submit->in_fence_fd,
+   };
+
+   struct kgsl_command_syncpoint sync = {
+      .type = KGSL_CMD_SYNCPOINT_TYPE_FENCE,
+      .size = sizeof(sync_fence),
+      .priv = (uintptr_t)&sync_fence,
+   };
+
+   struct kgsl_gpu_command req = {
+      .flags = KGSL_CMDBATCH_SUBMIT_IB_LIST,
+      .context_id = kgsl_pipe->queue_id,
+      .cmdlist = (uintptr_t)cmds,
+      .numcmds = cmd_idx,
+      .cmdsize = sizeof(struct kgsl_command_object),
+      .synclist = (uintptr_t)&sync,
+      .syncsize = sizeof(struct kgsl_command_syncpoint),
+      .numsyncs = sync_fence.fd != -1 ? 1 : 0,
+   };
+
+   int ret = kgsl_safe_ioctl(pipe->dev->fd, IOCTL_KGSL_GPU_COMMAND, &req);
+   if (ret) {
+      ERROR_MSG("submit failed: %d (%s)", ret, strerror(errno));
+      goto out;
+   }
+
+   fd_submit->out_fence->kfence = req.timestamp;
+
+   if (fd_submit->out_fence->use_fence_fd) {
+      int fd = timestamp_to_fd(pipe, req.timestamp);
+      if (fd < 0) {
+         ERROR_MSG("failed to create sync file for timestamp: %s",
+                   strerror(errno));
+         ret = -1;
+         goto out;
+      }
+
+      fd_submit->out_fence->fence_fd = fd;
+   }
+
+out:
+   if (fd_submit->in_fence_fd != -1)
+      close(fd_submit->in_fence_fd);
+
+   return ret;
+}
+
+struct fd_submit *
+kgsl_submit_sp_new(struct fd_pipe *pipe)
+{
+   return fd_submit_sp_new(pipe, flush_submit_list);
+}
